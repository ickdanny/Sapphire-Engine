include "res/script/header/movement.nech";

let finalAngle := $1 * 60.0;

let initWaitSecs := 0.5;
let finalSpeedLow := 15.0;
let finalSpeedHigh := 25.0;
let angleRand := 10.0;
let speedTicks := 90;

setAngle(
    finalAngle + random(-angleRand, angleRand)
);
shiftSpeedPeriod(
    random(finalSpeedLow, finalSpeedHigh),
    speedTicks
);