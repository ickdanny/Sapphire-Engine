# bullet script for double turning laser spawners

include "res/script/header/timing.nech";
include "res/script/header/movement.nech";
include "res/script/header/enemy.nech";
include "res/script/header/danmaku.nech";

# control parameters

var turnAngle := diff(30, 60, 90);
if($1 == 1){
    turnAngle := -turnAngle;
}

let shiftTicks := 50;
let waitSecs := 0.4;
let midSpeed := 50.0;
let endSpeedBeforeGravity := 20;
let endSpeedTicks := 20;

let gravAccel := 0.5;
let gravDragLow := 0.001;
let gravDragHigh := 0.0015;
let gravDrag := random(gravDragLow, gravDragHigh);
let gravDirectionRange := 10.0;

# laser spawning

let segmentsBeforeSpawner := diff(7, 6, 6);

var segmentCount := 1;
let spawnRandomLaser := \() -> {
    let r := random(0.0, 1.0);
    let pos := getPosition();
    let angle := getAngle();
    let scriptId := "laser_boss4_9";

    var prototypeId;
    var arg;

    if(r < 1.0/6.0) {
        prototypeId := "laser_red";
        arg := 1;
    }
    else if(r < 2.0/6.0) {
        prototypeId := "laser_orange";
        arg := 2;
    }
    else if(r < 3.0/6.0) {
        prototypeId := "laser_lyellow";
        arg := 3;
    }
    else if(r < 4.0/6.0) {
        prototypeId := "laser_lgreen";
        arg := 4;
    }
    else if(r < 5.0/6.0) {
        prototypeId := "laser_lblue";
        arg := 5;
    }
    else{
        prototypeId := "laser_lpurple";
        arg := 6;
    }

    spawnLaser(
        pos,
        angle,
        \(pos, angle, depthOffset) -> {
            var argToPass := 0;
            if(segmentCount == segmentsBeforeSpawner){
                segmentCount := 0;
                argToPass := arg;
            }
            spawn(
                prototypeId,
                pos,
                <<0, angle>>,
                depthOffset,
                scriptId,
                argToPass
            );
            segmentCount += 1;
        }
    );
};

# bullet behavior

if($1 == 0 || $1 == 1){
    shiftVelocityTurnPeriod(
        0,
        getAngle() + turnAngle,
        shiftTicks
    );

    spawnRandomLaser();
    secTimer(waitSecs);

    shiftVelocityTurnPeriod(
        midSpeed,
        getAngle() - turnAngle,
        shiftTicks
    );
    shiftVelocityTurnPeriod(
        0,
        getAngle() - turnAngle,
        shiftTicks
    );

    spawnRandomLaser();
    secTimer(waitSecs);

    shiftSpeedPeriod(endSpeedBeforeGravity, endSpeedTicks);

    let gravDirection := 90.0
        + random(-gravDirectionRange, gravDirectionRange);
    gravity(gravDirection, gravAccel, gravDrag);
}
else if($1 == 2){
    shiftSpeedPeriod(0, shiftTicks);

    spawnRandomLaser();
    secTimer(waitSecs);

    shiftSpeedPeriod(endSpeedBeforeGravity, endSpeedTicks);

    let gravDirection := 90.0
        + random(-gravDirectionRange, gravDirectionRange);
    gravity(gravDirection, gravAccel, gravDrag);
}