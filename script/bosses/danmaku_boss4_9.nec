# final spell danmaku script: turning lasers

include "res/script/header/danmaku.nech";
include "res/script/header/math.nech";
include "res/script/header/enemy.nech";
include "res/script/header/timing.nech";

let symmetry := diff(10, 13, 16);
let secsBetweenSpawns1 := 2.9;
let secsBetweenSpawns2 := 0.4;
let secsBetweenSpawns3 := 3.5;

let initSpeedAB := 60.0;
let baseInitSpeedC := 70;
let initSpeedOffsetC := 20;
let angleOffsetC := -5.1;
let numRingsC := 3;

let spawnerPrototype := "tri_black";

let pos := getPosition();

let spawnRingA := \() -> {
    ring(
        <<initSpeedAB, randomAngle()>>,
        symmetry,
        \(vel, depthOffset) -> {
            spawn(
                spawnerPrototype,
                pos,
                vel,
                depthOffset,
                "bullet_boss4_9_a",
                0
            );
            yield;
        }
    );
};

let spawnRingB := \() -> {
    ring(
        <<initSpeedAB, randomAngle()>>,
        symmetry,
        \(vel, depthOffset) -> {
            spawn(
                spawnerPrototype,
                pos,
                vel,
                depthOffset,
                "bullet_boss4_9_a",
                1
            );
            yield;
        }
    );
};

let spawnRingsC := \() -> {
    var angle := randomAngle();
    var initSpeed := baseInitSpeedC;

    for(var i := 0; i < numRingsC; i += 1){
        ring(
            <<initSpeed, angle>>,
            symmetry,
            \(vel, depthOffset) -> {
                spawn(
                    spawnerPrototype,
                    pos,
                    vel,
                    depthOffset,
                    "bullet_boss4_9_a",
                    2
                );
                yield;
            }
        );
        angle += angleOffsetC;
        initSpeed += initSpeedOffsetC;
        secTimer(secsBetweenSpawns2);
    }
};

let spawnRingsD := \() -> { # same as C but other direction
    var angle := randomAngle();
    var initSpeed := baseInitSpeedC;

    for(var i := 0; i < numRingsC; i += 1){
        ring(
            <<initSpeed, angle>>,
            symmetry,
            \(vel, depthOffset) -> {
                spawn(
                    spawnerPrototype,
                    pos,
                    vel,
                    depthOffset,
                    "bullet_boss4_9_a", # no turn
                    2
                );
                yield;
            }
        );
        angle -= angleOffsetC;
        initSpeed += initSpeedOffsetC;
        secTimer(secsBetweenSpawns2);
    }
};

while(true){
    spawnRingA();
    secTimer(secsBetweenSpawns1);
    spawnRingB();
    secTimer(secsBetweenSpawns1);
    spawnRingsC();
    secTimer(secsBetweenSpawns3);

    spawnRingB();
    secTimer(secsBetweenSpawns1);
    spawnRingA();
    secTimer(secsBetweenSpawns1);
    spawnRingsD();
    secTimer(secsBetweenSpawns3);
}