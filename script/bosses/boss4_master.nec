# Juna Celesary

include "res/script/header/movement.nech";
include "res/script/header/timing.nech";

let clearLaserSpawners := \() -> {
    for(var i := 0; i < 70; i += 1){
        flagBulletClear();
        yield;
    }
};

gotoDecelerating(bossMidpoint(), 90.0);
flagBulletClear();

# use side effect to clear boss deaths channel in case
isBossDead();

startDialogue("b4_pre");

wait isDialogueOver();
setCollidable();

secTimer(0.5);

# phase 9: turning lasers; final spell
addScript("attack_boss4_9", 2);
wait isBossDead();
removeSpawns();
yield;
setVelocity(<<0, 0>>);
flagBulletClear();
clearLaserSpawners();

flagWin();
spawn(
    "explode_boss",
    getPosition(),
    <<0, 0>>,
    0,
    "remove_explode_boss"
);
removeEntity();