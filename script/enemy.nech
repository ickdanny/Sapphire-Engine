
# returns true if the position is closer to the left
# side than the right side, false otherwise
let isLeft := \(point) -> {
    # account for game offset
    point := point - gameOffset();
    return point.x < (gameWidth() / 2.0);
}

# switches on the difficulty value and selects the
# corresponding provided value
let diff := \(normalVal, hardVal, lunaticVal) -> {
    let difficulty := getDifficulty();
    if(difficulty == 1){
        return normalVal;
    }
    if(difficulty == 2){
        return hardVal;
    }
    if(difficulty == 3){
        return lunaticVal;
    }
    error("difficulty is not 1, 2, or 3");
}