# Welcome to Necro, a DSL for scripting shmup games!
# Single-line comments begin with the '#' symbol.

~ Multi-line comments use the tilde symbol and are not
  nested. ~

# Example 1: We demonstrate basic Necro syntax.

# immutable variable
let i := 1;

# mutable variable
var j := 2;
j += 3;

# all functions are lambdas
let func1 := \(x) -> {x * x};

# print keyword to print
print func(4);

# C-style while and for loops
while(j < 6){
    j += 1;
}
for(var k := 1; k < 10; k += 1){
    print k;
}

# yield keyword temporarily halts the interpreter
yield;

# wait statement waits for an external condition to be
# true
wait isReady(); # where isReady is a builtin external

# Example 2: Necro lambdas need not be bound to names.
print "expect 5 * 2 = 10";
print \(n) -> {return n * 2;}(5);

# Example 3: Necro supports nested lambda definitions.
let test := \(x) -> {
    let a := 2;
    let test2 := \(y) -> {return y + a;};
    let test3 := \(z) -> {
        return \(w) -> {return test2(w);}(z);
    };
    return test3(x);
};

print "expect 5 + 2 = 7";
print test(5);

# Example 4: Necro supports recursion using the 'self'
# keyword
let fib := \(n) -> {
    if(n <= 1){
        return n;
    }
    return self(n - 2) + self(n - 1);
};

print "expect fib(6) = 0 1 1 2 3 5 8";
print fib(6);